# Server configuration reference only. No browser key and no committed real credentials.
PORT=8787
AI_PUBLIC_ORIGIN=http://127.0.0.1:8787
AI_GENERATION_MODE=off
AI_DATA_DIR=/tmp/iustaz-ai-private
FIREBASE_PROJECT_ID=
# Inject via the server secret manager, never paste in chat or browser configuration.
GEMINI_API_KEY=
# Set an available JSON-schema-capable Gemini model from your Google AI project.
GEMINI_MODEL=
AI_DAILY_USER_LIMIT=3
AI_DAILY_GLOBAL_LIMIT=30
# Use workload identity/ADC. Do not put service-account JSON in this repository.
