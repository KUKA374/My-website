{
  "schemaVersion": 1,
  "id": "decimal-operations-v1",
  "title": "Ондық бөлшектер: көбейту және бөлу",
  "slides": [
    {
      "id": "slide-1",
      "title": "Ондық үлестер",
      "text": "Үтірден кейінгі орын санның үлесін анықтайды.",
      "formula": "1{,}25=\\frac{125}{100}",
      "diagram": {
        "kind": "number-line",
        "divisions": 10,
        "marks": [
          {
            "tick": 1,
            "label": "0,1"
          },
          {
            "tick": 5,
            "label": "0,5"
          },
          {
            "tick": 9,
            "label": "0,9"
          }
        ]
      },
      "steps": [
        "1,25 санында 125 жүздік үлес бар.",
        "125/100 = 1,25."
      ]
    },
    {
      "id": "slide-2",
      "title": "Соңындағы нөлдер",
      "text": "Бөлшек бөліктің соңындағы нөл мәнді өзгертпейді.",
      "formula": "1{,}2=1{,}20",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 10,
        "filled": 6
      },
      "steps": [
        "1,2 мен 1,20 бір нүктеге сәйкес келеді.",
        "Сызбадағы 6/10 = 0,6."
      ]
    },
    {
      "id": "slide-3",
      "title": "Қосу мысалы",
      "text": "Үтірлерді бірінің астына бірін келтір.",
      "formula": "2{,}36+1{,}40=3{,}76",
      "diagram": null,
      "steps": [
        "Разрядтарды теңестір: 1,4 санын 1,40 деп жаз.",
        "2,36 + 1,40 = 3,76."
      ]
    },
    {
      "id": "slide-4",
      "title": "Азайту мысалы",
      "text": "Қажет болса, бос разрядқа нөл жаз.",
      "formula": "5{,}70-2{,}85=2{,}85",
      "diagram": null,
      "steps": [
        "5,7 санын 5,70 деп жаз.",
        "5,70 − 2,85 = 2,85."
      ]
    },
    {
      "id": "slide-5",
      "title": "Натурал санға көбейту",
      "text": "Алдымен бүтін сандардай көбейт.",
      "formula": "1{,}35\\cdot4=5{,}4",
      "diagram": null,
      "steps": [
        "135 × 4 = 540.",
        "Екі ондық таңба: 540/100 = 5,4."
      ]
    },
    {
      "id": "slide-6",
      "title": "Ондық бөлшекке көбейту",
      "text": "Бөлшек таңбалардың санын қос.",
      "formula": "2{,}4\\cdot0{,}35=0{,}84",
      "diagram": null,
      "steps": [
        "24 × 35 = 840.",
        "Үш таңба: 840/1000 = 0,84."
      ]
    },
    {
      "id": "slide-7",
      "title": "Натурал санға бөлу",
      "text": "Үлестердің разрядын сақта.",
      "formula": "9{,}45:3=3{,}15",
      "diagram": null,
      "steps": [
        "945/3 = 315.",
        "315/100 = 3,15."
      ]
    },
    {
      "id": "slide-8",
      "title": "Ондық бөлшекке бөлу",
      "text": "Екі санды да бірдей есе өзгерт.",
      "formula": "4{,}32:0{,}12=432:12=36",
      "diagram": null,
      "steps": [
        "Бөлінгіш пен бөлгішті 100-ге көбейт.",
        "432/12 = 36."
      ]
    },
    {
      "id": "slide-9",
      "title": "Үтірді жылжыту себебі",
      "text": "Екі сан бірдей есе өссе, бөлінді өзгермейді.",
      "formula": "7{,}2:0{,}8=72:8=9",
      "diagram": null,
      "steps": [
        "Бөлгішті натурал сан ет.",
        "72/8 = 9."
      ]
    },
    {
      "id": "slide-10",
      "title": "Құнды табу мысалы",
      "text": "Массаны бірлік бағасына көбейт.",
      "formula": "2{,}5\\cdot760=1900",
      "diagram": null,
      "steps": [
        "1 кг бағасы 760 теңге, масса 2,5 кг.",
        "2,5 × 760 = 1900 теңге."
      ]
    },
    {
      "id": "slide-11",
      "title": "Амалдардың реті",
      "text": "Алдымен жақша, содан кейін бөлу.",
      "formula": "(6{,}4-1{,}6):0{,}4=12",
      "diagram": null,
      "steps": [
        "6,4 − 1,6 = 4,8.",
        "4,8/0,4 = 12."
      ]
    },
    {
      "id": "slide-12",
      "title": "Кері амалмен тексеру",
      "text": "Бөліндіні бөлгішке көбейт.",
      "formula": "3{,}15\\cdot3=9{,}45",
      "diagram": null,
      "steps": [
        "Бөлінді 3,15, бөлгіш 3.",
        "3,15 × 3 = 9,45 — бастапқы бөлінгіш."
      ]
    }
  ]
}
