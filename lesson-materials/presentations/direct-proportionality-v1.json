{
  "schemaVersion": 1,
  "id": "direct-proportionality-v1",
  "title": "Тура пропорционалдық: ереже, кесте және график",
  "slides": [
    {
      "id": "slide-1",
      "title": "Негізгі белгі",
      "text": "Бір шама неше есе өзгерсе, екіншісі сонша есе өзгереді.",
      "formula": "y=kx",
      "diagram": null,
      "steps": [
        "k — тұрақты коэффициент.",
        "Жай қатар өсу жеткіліксіз."
      ]
    },
    {
      "id": "slide-2",
      "title": "Коэффициент",
      "text": "Нөл емес x үшін y/x тұрақты.",
      "formula": "k=\\frac yx,\\quad x\\ne0",
      "diagram": null,
      "steps": [
        "14/2 = 28/4 = 42/6 = 7.",
        "Бұл мәндер үшін коэффициент 7."
      ]
    },
    {
      "id": "slide-3",
      "title": "Кесте құру",
      "text": "Ереже әр бағанға бірдей қолданылады.",
      "formula": "y=3x",
      "diagram": null,
      "steps": [
        "x мәндері: 1, 2, 3.",
        "y мәндері: 3, 6, 9; 3/1 = 6/2 = 9/3 = 3."
      ]
    },
    {
      "id": "slide-4",
      "title": "График",
      "text": "Түзу координаталар басынан өтеді.",
      "formula": "y=3x",
      "diagram": {
        "kind": "coordinate-graph",
        "maxX": 4,
        "maxY": 12,
        "points": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 6
          },
          {
            "x": 3,
            "y": 9
          },
          {
            "x": 4,
            "y": 12
          }
        ],
        "xLabel": "x",
        "yLabel": "y"
      },
      "steps": [
        "(0;0), (1;3), (2;6), (3;9), (4;12) нүктелерін белгіле.",
        "x мәні екі есе артса, y де екі есе артады."
      ]
    },
    {
      "id": "slide-5",
      "title": "Нөлді дұрыс түсін",
      "text": "Ережеде x нөл болса, y нөл. k үшін 0/0 алмаймыз.",
      "formula": "3\\cdot0=0",
      "diagram": null,
      "steps": [
        "Коэффициент үшін нөл емес x бар жұпты таңда.",
        "6/2 = 3."
      ]
    },
    {
      "id": "slide-6",
      "title": "Құн мен масса",
      "text": "Бірлік баға өзгермегенде құн массаға тура пропорционал.",
      "formula": "1500:2{,}5=600",
      "diagram": null,
      "steps": [
        "1500/2,5 = 600 теңге/кг.",
        "4,2 кг үшін 600 × 4,2 = 2520 теңге."
      ]
    },
    {
      "id": "slide-7",
      "title": "Жол мен уақыт",
      "text": "Жылдамдық тұрақты және бастапқы қосымша жол жоқ.",
      "formula": "s=72t",
      "diagram": null,
      "steps": [
        "72 × 2,5 = 180 км.",
        "180/2,5 = 72 км/сағ."
      ]
    },
    {
      "id": "slide-8",
      "title": "Кері сұрақ",
      "text": "Берілген y бойынша x-ті коэффициентке бөл.",
      "formula": "x=\\frac yk,\\quad k\\ne0",
      "diagram": null,
      "steps": [
        "13 бөлшек/мин өнімділікте 117/13 = 9 минут.",
        "13 × 9 = 117."
      ]
    },
    {
      "id": "slide-9",
      "title": "Қатар өссе де тура емес",
      "text": "Қосымша тұрақты мүше қатынасты өзгертеді.",
      "formula": "y=4x+6",
      "diagram": null,
      "steps": [
        "x мәні 1: 4 × 1 + 6 = 10; x мәні 2: 4 × 2 + 6 = 14.",
        "10/1 = 10; 14/2 = 7. Қатынастар тең емес."
      ]
    },
    {
      "id": "slide-10",
      "title": "Тұрақты төлем",
      "text": "Бастапқы жеткізу ақысы бар құн тура пропорционал емес.",
      "formula": "y=200x+300",
      "diagram": null,
      "steps": [
        "1 дәптер 500 теңге, 2 дәптер 700 теңге.",
        "500/1 = 500; 700/2 = 350."
      ]
    },
    {
      "id": "slide-11",
      "title": "Ережеден есептеу",
      "text": "Коэффициент бөлшек сан да болуы мүмкін.",
      "formula": "y=3{,}75x",
      "diagram": null,
      "steps": [
        "30/8 = 3,75.",
        "x мәні 12 болса, 3,75 × 12 = 45."
      ]
    },
    {
      "id": "slide-12",
      "title": "Толық алгоритм",
      "text": "Тұрақты шарт → k → ереже → есептеу → тексеру.",
      "formula": "y=kx",
      "diagram": null,
      "steps": [
        "Масса мен құн үшін бірлік бағаны ата.",
        "Бұл сабақ тура пропорционалдық туралы; кері тәуелділік келесі сабақта."
      ]
    }
  ]
}
