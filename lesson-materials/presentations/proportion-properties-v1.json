{
  "schemaVersion": 1,
  "id": "proportion-properties-v1",
  "title": "Пропорцияның негізгі қасиеті және қолданылуы",
  "slides": [
    {
      "id": "slide-1",
      "title": "Қасиеттің негізі",
      "text": "Екі қатынас тең болса, екі жақты bd-ға көбейтуге болады.",
      "formula": "\\frac ab=\\frac cd\\Rightarrow ad=bc",
      "diagram": null,
      "steps": [
        "b және d нөл емес.",
        "Сол жақта b, оң жақта d қысқарады."
      ]
    },
    {
      "id": "slide-2",
      "title": "Шеткі және ортаңғы көбейтінді",
      "text": "Шеткі мүшелер көбейтіндісі ортаңғы мүшелер көбейтіндісіне тең.",
      "formula": "4:8=1:2",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 8,
        "filled": 4
      },
      "steps": [
        "4 × 2 = 8 × 1 = 8.",
        "Мүшелердің орнын жазылымнан анықта."
      ]
    },
    {
      "id": "slide-3",
      "title": "Төрт қадам",
      "text": "Пропорция → көбейтінді теңдеуі → белгісіз → тексеру.",
      "formula": "x:15=4:5",
      "diagram": null,
      "steps": [
        "5 × x = 15 × 4.",
        "15 × 4/5 = 12; 12/15 = 4/5."
      ]
    },
    {
      "id": "slide-4",
      "title": "Бөлімдегі белгісіз",
      "text": "Белгісіз бөлімнің нөлден өзгеше болуын тексер.",
      "formula": "14:x=7:9",
      "diagram": null,
      "steps": [
        "14 × 9 = 7 × x.",
        "14 × 9/7 = 18; 14/18 = 7/9."
      ]
    },
    {
      "id": "slide-5",
      "title": "Үшінші орында",
      "text": "Сәйкес көбейтіндіні жаз.",
      "formula": "0{,}6:1{,}5=x:10",
      "diagram": null,
      "steps": [
        "0,6 × 10 = 1,5 × x.",
        "0,6 × 10/1,5 = 4; 0,6/1,5 = 4/10."
      ]
    },
    {
      "id": "slide-6",
      "title": "Төртінші орында",
      "text": "Белгілі шеткі мүше арқылы бөл.",
      "formula": "16:24=10:x",
      "diagram": null,
      "steps": [
        "16 × x = 24 × 10.",
        "24 × 10/16 = 15; 16/24 = 10/15."
      ]
    },
    {
      "id": "slide-7",
      "title": "Бөлшек мүшелер",
      "text": "Қасиет бөлшек сандарға да қолданылады.",
      "formula": "\\frac34:\\frac12=x:8",
      "diagram": null,
      "steps": [
        "(3/4) × 8 = (1/2) × x.",
        "((3/4) × 8)/(1/2) = 12; (3/4) : (1/2) = 12/8."
      ]
    },
    {
      "id": "slide-8",
      "title": "Өрнекті бір мүше деп ал",
      "text": "Жақшаны сақтап, белгісізді ретімен тап.",
      "formula": "(x+2):9=4:3",
      "diagram": null,
      "steps": [
        "3 × (x + 2) = 9 × 4.",
        "9 × 4/3 = 12; 12 − 2 = 10; (10 + 2)/9 = 4/3."
      ]
    },
    {
      "id": "slide-9",
      "title": "Бірдей баға",
      "text": "Құн:сан қатынасын екі жақта сақта.",
      "formula": "1020:6=x:9",
      "diagram": null,
      "steps": [
        "1020 × 9 = 6 × x.",
        "1020 × 9/6 = 1530; 1530/9 = 1020/6 = 170."
      ]
    },
    {
      "id": "slide-10",
      "title": "Пайыз және бүтін",
      "text": "Бөлік:бүтін қатынасы пайыз:100 қатынасына тең.",
      "formula": "42:x=35:100",
      "diagram": null,
      "steps": [
        "42 × 100 = 35 × x.",
        "42 × 100/35 = 120; 120 × 35/100 = 42."
      ]
    },
    {
      "id": "slide-11",
      "title": "Материал шығыны",
      "text": "Бірдей бұйымға жұмсалатын мата мөлшері тұрақты.",
      "formula": "4{,}8:12=x:17",
      "diagram": null,
      "steps": [
        "4,8 × 17 = 12 × x.",
        "4,8 × 17/12 = 6,8; 6,8/17 = 4,8/12 = 0,4."
      ]
    },
    {
      "id": "slide-12",
      "title": "Қате модельді түзету",
      "text": "Мүшелердің мағынасы мен реті сәйкес болсын.",
      "formula": "3600:8=x:5",
      "diagram": null,
      "steps": [
        "8 кітап 3600 теңге; құн:сан бағытын сақта.",
        "3600 × 5/8 = 2250; 2250/5 = 3600/8 = 450."
      ]
    }
  ]
}
