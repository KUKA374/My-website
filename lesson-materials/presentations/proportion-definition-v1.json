{
  "schemaVersion": 1,
  "id": "proportion-definition-v1",
  "title": "Пропорцияны тану және құрастыру",
  "slides": [
    {
      "id": "slide-1",
      "title": "Пропорция деген не?",
      "text": "Пропорция — екі қатынастың теңдігі.",
      "formula": "a:b=c:d",
      "diagram": null,
      "steps": [
        "Төрт санды жазу жеткіліксіз.",
        "Екі бөліндінің мәні бірдей болуы керек."
      ]
    },
    {
      "id": "slide-2",
      "title": "Бөлімдерді тексер",
      "text": "Екінші және төртінші мүшелер нөл емес.",
      "formula": "b\\ne0,\\quad d\\ne0",
      "diagram": null,
      "steps": [
        "Бөлшек жазылымы — a/b және c/d.",
        "Нөл бөлімді жазылым пропорция бола алмайды."
      ]
    },
    {
      "id": "slide-3",
      "title": "Бірдей үлес",
      "text": "Сызбадағы үлес екі түрлі бөлшекпен жазылады.",
      "formula": "\\frac36=\\frac12",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 6,
        "filled": 3
      },
      "steps": [
        "3/6 = 1/2.",
        "Бөлшектер бірдей боялған бөлікті сипаттайды."
      ]
    },
    {
      "id": "slide-4",
      "title": "Қысқартып тану",
      "text": "Екі қатынасты қысқартылған түрде салыстыр.",
      "formula": "\\frac69=\\frac{10}{15}=\\frac23",
      "diagram": null,
      "steps": [
        "6/9 = 2/3.",
        "10/15 = 2/3. Демек, теңдік — пропорция."
      ]
    },
    {
      "id": "slide-5",
      "title": "Тең емес мысал",
      "text": "Қысқартылған мәндер бірдей болмаса, пропорция жоқ.",
      "formula": "\\frac7{10}\\ne\\frac{14}{25}",
      "diagram": null,
      "steps": [
        "7/10 = 0,7.",
        "14/25 = 0,56. Мәндер әртүрлі."
      ]
    },
    {
      "id": "slide-6",
      "title": "Шеткі мүшелер",
      "text": "Бірінші және соңғы мүшелер — шеткі.",
      "formula": "6:9=10:15",
      "diagram": null,
      "steps": [
        "Шеткі мүшелер — 6 және 15.",
        "Ортаңғы мүшелер — 9 және 10."
      ]
    },
    {
      "id": "slide-7",
      "title": "Пропорцияны оқу",
      "text": "Әр қатынасты бірдей бағытта оқы.",
      "formula": "4:6=10:15",
      "diagram": null,
      "steps": [
        "Төрттің алтыға қатынасы онның он беске қатынасына тең.",
        "4/6 = 10/15 = 2/3."
      ]
    },
    {
      "id": "slide-8",
      "title": "Тең қатынас құрастыру",
      "text": "Екі мүшені де бірдей санға көбейт.",
      "formula": "5:8=15:24",
      "diagram": null,
      "steps": [
        "5 × 3 = 15.",
        "8 × 3 = 24."
      ]
    },
    {
      "id": "slide-9",
      "title": "Бір мүшені өзгерту қатесі",
      "text": "Бір ғана мүшені өзгерту мәнді сақтамайды.",
      "formula": "\\frac28\\ne\\frac48",
      "diagram": null,
      "steps": [
        "2/8 = 1/4.",
        "4/8 = 1/2. Екі мүшені де өзгерту қажет."
      ]
    },
    {
      "id": "slide-10",
      "title": "Ондық сандар",
      "text": "Ондық мүшелерді бүтінге келтіріп қысқарт.",
      "formula": "0{,}9:1{,}5=3:5",
      "diagram": null,
      "steps": [
        "Екі мүшені 10-ға көбейт: 9:15.",
        "9/15 = 3/5."
      ]
    },
    {
      "id": "slide-11",
      "title": "Тұрақты баға мысалы",
      "text": "Құн:сан реті екі жақта бірдей.",
      "formula": "600:4=1050:7",
      "diagram": null,
      "steps": [
        "600/4 = 150.",
        "1050/7 = 150. Бірлік баға тең."
      ]
    },
    {
      "id": "slide-12",
      "title": "Тану алгоритмі",
      "text": "Нөлді тексер → қысқарт → салыстыр → дұрыс оқы.",
      "formula": "3:7=12:28",
      "diagram": null,
      "steps": [
        "3 × 4 = 12; 7 × 4 = 28.",
        "Мүшелерді бірдей есе өзгертіп пропорция құрастыруға болады."
      ]
    }
  ]
}
