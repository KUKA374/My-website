{
  "schemaVersion": 1,
  "id": "sets-union-intersection-v1",
  "title": "Жиындар: қиылысу, бірігу және Венн сызбасы",
  "slides": [
    {
      "id": "slide-1",
      "title": "Жиын — объектілер тобы",
      "text": "Бір жиында элемент қайталанып есептелмейді.",
      "formula": "A=\\{1,2,4,6\\}",
      "diagram": null,
      "steps": [
        "Жиын атауын бас әріппен белгіле.",
        "Элементтерді ирек жақшаға жаз."
      ]
    },
    {
      "id": "slide-2",
      "title": "Тиісті болу",
      "text": "Элементтің жиынға кіретінін тексер.",
      "formula": "2\\in A,\\quad 5\\notin A",
      "diagram": null,
      "steps": [
        "A жиынынан 2-ні тап: ол бар.",
        "5 саны A-да жоқ."
      ]
    },
    {
      "id": "slide-3",
      "title": "Қиылысудың мағынасы",
      "text": "Екі жиынға да ортақ элементтер алынады.",
      "formula": "A\\cap B=\\{2,6\\}",
      "diagram": {
        "kind": "venn",
        "leftLabel": "A",
        "rightLabel": "B",
        "leftOnly": [
          "1",
          "4"
        ],
        "common": [
          "2",
          "6"
        ],
        "rightOnly": [
          "3",
          "8"
        ],
        "outside": [
          "5",
          "7"
        ]
      },
      "steps": [
        "A={1,2,4,6}, B={2,3,6,8}.",
        "Екеуінде де 2 мен 6 бар."
      ]
    },
    {
      "id": "slide-4",
      "title": "Қиылысу мысалы",
      "text": "Ортақ элементке екі шарт қатар орындалады.",
      "formula": "\\{1,4,7\\}\\cap\\{4,6,7\\}=\\{4,7\\}",
      "diagram": null,
      "steps": [
        "Бірінші жиынның элементтерін тексер.",
        "4 пен 7 екіншісінде де бар."
      ]
    },
    {
      "id": "slide-5",
      "title": "Бірігудің мағынасы",
      "text": "Кемінде бір жиынға тиісті элементтер алынады.",
      "formula": "A\\cup B=\\{1,2,3,4,6,8\\}",
      "diagram": {
        "kind": "venn",
        "leftLabel": "A",
        "rightLabel": "B",
        "leftOnly": [
          "1",
          "4"
        ],
        "common": [
          "2",
          "6"
        ],
        "rightOnly": [
          "3",
          "8"
        ],
        "outside": [
          "5",
          "7"
        ]
      },
      "steps": [
        "Алдымен A элементтерін жаз.",
        "B-ден жаңа 3 пен 8-ді қос."
      ]
    },
    {
      "id": "slide-6",
      "title": "Қайталанатын элемент",
      "text": "Ортақ элемент бірігуде бір рет қана жазылады.",
      "formula": "\\{3,6,9\\}\\cup\\{6,10,12\\}=\\{3,6,9,10,12\\}",
      "diagram": null,
      "steps": [
        "6 екі жиында да бар.",
        "Жауапта 6-ны бір рет жаз."
      ]
    },
    {
      "id": "slide-7",
      "title": "Бос қиылысу",
      "text": "Ортақ элемент болмауы мүмкін.",
      "formula": "\\{2,4\\}\\cap\\{1,3\\}=\\varnothing",
      "diagram": null,
      "steps": [
        "Жұп және тақ сандар тізімдерін салыстыр.",
        "Екеуіне ортақ элемент жоқ."
      ]
    },
    {
      "id": "slide-8",
      "title": "Бос жиын және нөл",
      "text": "Элементтің болмауы мен нөл элементі бар болуды ажырат.",
      "formula": "\\varnothing\\ne\\{0\\}",
      "diagram": null,
      "steps": [
        "Бос жиында элемент саны нөл.",
        "{0} жиынында бір элемент бар."
      ]
    },
    {
      "id": "slide-9",
      "title": "Бірігу санын табу",
      "text": "Ортақ бөлікті қосындыдан бір рет азайт.",
      "formula": "n(A\\cup B)=n(A)+n(B)-n(A\\cap B)",
      "diagram": null,
      "steps": [
        "Екі жиындағы сандарды қос.",
        "Ортақ элементтерді бір рет алып таста."
      ]
    },
    {
      "id": "slide-10",
      "title": "Санаудың шешілген мысалы",
      "text": "Ән мен биге қатысатын оқушыларды сана.",
      "formula": "20+13-8=25",
      "diagram": null,
      "steps": [
        "20 + 13 = 33.",
        "33 − 8 = 25."
      ]
    },
    {
      "id": "slide-11",
      "title": "Екі жиынға да кірмейтіндер",
      "text": "Барлық саннан бірігу санын азайт.",
      "formula": "30-25=5",
      "diagram": null,
      "steps": [
        "Барлығы 30, кемінде бір үйірмеде 25 оқушы бар.",
        "30 − 25 = 5 оқушы екеуіне де қатыспайды."
      ]
    },
    {
      "id": "slide-12",
      "title": "Тексеру алгоритмі",
      "text": "Әр элементтің қай аймаққа кіретінін негізде.",
