{
  "schemaVersion": 1,
  "id": "inverse-ratios-v1",
  "title": "Қатынасты оқу және кері қатынас",
  "slides": [
    {
      "id": "slide-1",
      "title": "Қай шаманы салыстырамыз?",
      "text": "Қатынаста бірінші аталған шама алдыңғы орында тұрады.",
      "formula": "a:b=\\frac{a}{b}",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 5,
        "filled": 3
      },
      "steps": [
        "Үш боялған, екі боялмаған бөлік бар.",
        "Боялған:боялмаған — 3:2."
      ]
    },
    {
      "id": "slide-2",
      "title": "Оқу және жазу",
      "text": "a-ның b-ге қатынасы деп оқы. Екінші мүше нөл емес.",
      "formula": "b\\ne0",
      "diagram": null,
      "steps": [
        "8:12 — сегіздің он екіге қатынасы.",
        "8/12 = 2/3."
      ]
    },
    {
      "id": "slide-3",
      "title": "Кері қатынас",
      "text": "Мүшелердің орны ауысады; салыстыру бағыты өзгереді.",
      "formula": "a:b\\quad\\longrightarrow\\quad b:a",
      "diagram": null,
      "steps": [
        "8:12 үшін кері жазылым — 12:8.",
        "12/8 = 3/2."
      ]
    },
    {
      "id": "slide-4",
      "title": "Көрнекі салыстыру",
      "text": "Боялғанның боялмағанға және керісінше қатынасын салыстыр.",
      "formula": "3:1\\quad\\text{және}\\quad1:3",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 4,
        "filled": 3
      },
      "steps": [
        "Боялған бөліктер саны — 3, боялмағаны — 1.",
        "Қай шаманы бірінші атағаныңды тексер."
      ]
    },
    {
      "id": "slide-5",
      "title": "Қысқарту",
      "text": "Қысқарту ретті өзгертпейді.",
      "formula": "20:12=5:3",
      "diagram": null,
      "steps": [
        "20/4 = 5; 12/4 = 3.",
        "Бастапқы 12:20 қатынасына кері — 5:3."
      ]
    },
    {
      "id": "slide-6",
      "title": "Бірлікті теңестір",
      "text": "Ұзындықтарды бірдей бірлікпен жаз.",
      "formula": "150:90=5:3",
      "diagram": null,
      "steps": [
        "1,5 м — 150 см.",
        "90 см-дің 1,5 м-ге қатынасына кері — 150:90."
      ]
    },
    {
      "id": "slide-7",
      "title": "Ондық мүшелер",
      "text": "Екі мүшені бірдей есе өзгерт.",
      "formula": "1{,}2:0{,}4=12:4=3:1",
      "diagram": null,
      "steps": [
        "Екі мүшені де 10-ға көбейт.",
        "12/4 = 3."
      ]
    },
    {
      "id": "slide-8",
      "title": "Бөлшек мүшелер",
      "text": "Ортақ бөлім мүшелерді бүтінге келтіреді.",
      "formula": "\\frac56:\\frac23=5:4",
      "diagram": null,
      "steps": [
        "(5/6) × 6 = 5.",
        "(2/3) × 6 = 4."
      ]
    },
    {
      "id": "slide-9",
      "title": "Бөлік пен бүтін",
      "text": "Кері қатынас — екі бөліктің орын ауысуы; бүтінге қатынас басқа.",
      "formula": "3:2\\quad2:3\\quad3:5",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 5,
        "filled": 3
      },
      "steps": [
        "Бөліктер саны: 3 + 2 = 5.",
        "Қызыл:көк — 3:2; көк:қызыл — 2:3; қызыл:барлығы — 3:5."
      ]
    },
    {
      "id": "slide-10",
      "title": "Нөлге бөлуге болмайды",
      "text": "Кері қатынас екі мүшесі де нөл емес кезде анықталады.",
      "formula": "0:5=0",
      "diagram": null,
      "steps": [
        "0:5 қатынасының мәні бар.",
        "5:0 анықталмайды; кері қатынасты құруға болмайды."
      ]
    },
    {
      "id": "slide-11",
      "title": "Мәндермен тексеру",
      "text": "Бастапқы және кері қатынас мәндерінің көбейтіндісі бір.",
      "formula": "\\frac23\\cdot\\frac32=1",
      "diagram": null,
      "steps": [
        "2/3 және 3/2 — өзара кері мәндер.",
        "(2/3) × (3/2) = 1."
      ]
    },
    {
      "id": "slide-12",
      "title": "Қорытынды алгоритм",
      "text": "Оқы → бірлікті теңестір → ауыстыр → қысқарт → тексер.",
      "formula": "7:7=1:1",
      "diagram": null,
      "steps": [
        "Мүшелер тең болса, кері қатынас та сол мәнде.",
        "Салыстыру бағытын толық сөйлеммен түсіндір."
      ]
    }
  ]
}
