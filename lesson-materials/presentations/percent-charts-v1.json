      ]
    },
    {
      "id": "slide-7",
      "title": "Бүтін санды табу",
      "text": "Барлық санат мәндерін қос.",
      "formula": "12+8+16+4=40",
      "diagram": {
        "kind": "bar-chart",
        "max": 20,
        "categories": [
          {
            "label": "Кітап",
            "value": 12
          },
