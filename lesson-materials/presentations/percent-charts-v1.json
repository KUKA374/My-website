      "steps": [
        "Бір бүтін 100% деп алынады.",
        "Сызбада 3/10 бөлік немесе 30% боялған."
      ]
    },
    {
      "id": "slide-2",
      "title": "Бөлшек пен пайыз",
      "text": "Пайызды жүздік бөлшек арқылы жаз.",
      "formula": "30\\%=\\frac{30}{100}=0{,}3",
      "diagram": null,
      "steps": [
        "30 пайыз — жүзден отыз бөлік.",
        "30/100 = 0,3."
      ]
    },
    {
      "id": "slide-3",
      "title": "Жиі кездесетін үлестер",
      "text": "Таныс үлестер шамалауды жеңілдетеді.",
      "formula": "50\\%=\\frac12,\\quad25\\%=\\frac14",
      "diagram": null,
      "steps": [
        "50% — жартысы.",
        "25% — төрттен бірі."
      ]
    },
    {
      "id": "slide-4",
      "title": "Санның пайызын табу",
      "text": "Бүтінді пайыздың жүздік бөлшегіне көбейт.",
      "formula": "200\\cdot\\frac{12}{100}=24",
      "diagram": null,
      "steps": [
        "200 — бүтін шама.",
        "200 × 12/100 = 24."
      ]
    },
    {
      "id": "slide-5",
      "title": "Бөліктің пайызын табу",
      "text": "Бөлікті бүтінге бөл.",
      "formula": "\\frac{5}{20}\\cdot100=25",
      "diagram": null,
      "steps": [
        "20 кітаптың 5-еуі ертегі.",
        "5/20 × 100 = 25 пайыз."
      ]
    },
    {
      "id": "slide-6",
      "title": "Диаграмманың осьтері",
