      "title": "Жеңілдік",
      "text": "Пайыздық соманы бастапқы бағадан азайт.",
      "formula": "8000-8000\\cdot\\frac{20}{100}=6400",
      "diagram": null,
      "steps": [
        "8000 × 20/100 = 1600 — жеңілдік.",
        "8000 − 1600 = 6400."
      ]
    },
    {
      "id": "slide-10",
      "title": "Кері есеп",
      "text": "Қалған пайызға бөлу арқылы бүтінді тап.",
      "formula": "6400:0{,}8=8000",
      "diagram": null,
      "steps": [
        "Жеңілдіктен кейін 80% қалды.",
        "6400/0,8 = 8000."
      ]
    },
    {
      "id": "slide-11",
      "title": "Тізбектелген өзгеріс",
      "text": "Әр пайыз жаңа шамадан есептеледі.",
      "formula": "1000\\cdot1{,}1\\cdot1{,}2=1320",
      "diagram": null,
      "steps": [
        "1000 × 1,1 = 1100.",
        "1100 × 1,2 = 1320.",
        "Өсім 30% емес, 32%."
      ]
    },
    {
      "id": "slide-12",
      "title": "Нәтижені тексеру",
      "text": "Бір бүтінді бөлетін үлестердің қосындысы 100%.",
