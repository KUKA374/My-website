{
  "schemaVersion": 1,
  "id": "ratios-percent-v1",
  "title": "Қатынас: мағынасы, қысқарту және пайыз",
  "slides": [
    {
      "id": "slide-1",
      "title": "Қатынас — бөлінді",
      "text": "Бірінші шаманы екіншісімен салыстыр.",
      "formula": "10:5=2",
      "diagram": null,
      "steps": [
        "Бірінші сан — 10, екіншісі — 5.",
        "10/5 = 2: бірінші сан екі есе үлкен."
      ]
    },
    {
      "id": "slide-2",
      "title": "Ретті сақтау",
      "text": "Қызылдың көкке қатынасы — бірінші қызыл, кейін көк.",
      "formula": "6:9=2:3",
      "diagram": {
        "kind": "bar-chart",
        "max": 12,
        "categories": [
          {
            "label": "Қызыл",
            "value": 6
          },
          {
            "label": "Көк",
            "value": 9
          }
        ]
      },
      "steps": [
        "Қызыл — 6, көк — 9.",
        "6/3 = 2; 9/3 = 3."
      ]
    },
    {
      "id": "slide-3",
      "title": "Мәні бірдей қатынастар",
      "text": "Екі мүшені бірдей санға көбейт не бөл.",
      "formula": "2:3=4:6=10:15",
      "diagram": null,
      "steps": [
        "Екі мүшені 2-ге көбейтсек, 4:6 шығады.",
        "Екі мүшені 5-ке көбейтсек, 10:15 шығады."
      ]
    },
    {
      "id": "slide-4",
      "title": "Бірдей бірлік",
      "text": "Метр мен сантиметрді тікелей салыстырма.",
      "formula": "300:120=5:2",
      "diagram": null,
      "steps": [
        "3 м — 300 см.",
        "300/60 = 5; 120/60 = 2."
      ]
    },
    {
      "id": "slide-5",
      "title": "Бөлік және бүтін",
      "text": "2:3 қатынасында барлық үлес саны 5.",
      "formula": "2+3=5",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 5,
        "filled": 2
      },
      "steps": [
        "Қызылдың көкке қатынасы — 2:3.",
        "Қызылдың барлық затқа қатынасы — 2:5."
      ]
    },
    {
      "id": "slide-6",
      "title": "Пайыздық үлес",
      "text": "Бөлік санын бүтін санға бөл.",
      "formula": "\\frac{6}{15}\\cdot100=40",
      "diagram": null,
      "steps": [
        "6 + 9 = 15 — барлық зат.",
        "6/15 × 100 = 40 пайыз — қызыл үлесі."
      ]
    },
    {
      "id": "slide-7",
      "title": "Қатынас пен нақты сан",
      "text": "2:3 қатынасы абсолют санды бермейді.",
      "formula": "4:6=2:3",
      "diagram": null,
      "steps": [
        "4 пен 6 да, 10 мен 15 те 2:3 қатынасын береді.",
        "Нақты сандарды табу үшін қосымша шама керек."
      ]
    },
    {
      "id": "slide-8",
      "title": "Қосынды бойынша үлестер",
      "text": "Жалпы санды үлестер қосындысына бөл.",
      "formula": "25:(2+3)=5",
      "diagram": null,
      "steps": [
        "Жалпы 25 зат, қатынасы 2:3.",
        "25/(2+3) = 5 — бір үлес.",
        "5 × 2 = 10; 5 × 3 = 15."
      ]
    },
    {
      "id": "slide-9",
      "title": "Өз шешіміңді тексер",
      "text": "Қатынасты, бірлікті және бүтінді қайта қара.",
      "formula": "10:15=2:3",
      "diagram": null,
      "steps": [
        "10 + 15 = 25 — берілген қосынды.",
        "10:15 = 2:3 — қатынас та сақталған."
      ]
    },
    {
      "id": "slide-10",
      "title": "Келесі сабақ: кері қатынас",
      "text": "Бұл бөлік №6 КТП сабағына ортақ теория.",
      "formula": "2:3\\longrightarrow3:2",
      "diagram": null,
      "steps": [
        "Кері қатынаста мүшелердің орнын ауыстыр.",
        "Жаңа бірінші мүше — 3, екіншісі — 2."
      ]
    },
    {
      "id": "slide-11",
      "title": "Кері қатынастың мәні",
      "text": "Мүшелерді ауыстыру мәнді кері санға өзгертеді.",
      "formula": "\\frac23\\cdot\\frac32=1",
      "diagram": null,
      "steps": [
        "2/3 × 3/2 = 1.",
        "Екі мүшенің де нөлден өзге болуын тексер."
      ]
    },
    {
      "id": "slide-12",
      "title": "Оқу және жазу",
      "text": "Қай шаманы қайсымен салыстырғаныңды айт.",
      "formula": "4:7\\longrightarrow7:4",
      "diagram": null,
      "steps": [
        "4:7 — біріншінің екіншіге қатынасы.",
        "7:4 — екіншінің біріншіге қатынасы."
      ]
    }
  ]
}
