{
  "schemaVersion": 1,
  "id": "fractions-operations-v2",
  "title": "Жай бөлшектер: түсіну, амалдар және тексеру",
  "slides": [
    {
      "id": "slide-1",
      "title": "Бөлшек нені білдіреді?",
      "text": "Алым алынған бөліктерді, бөлім барлық тең бөліктерді көрсетеді.",
      "formula": "",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 4,
        "filled": 3
      },
      "steps": [
        "Бүтін 4 тең бөлікке бөлінген.",
        "Үш бөлік боялған: бұл 3/4."
      ]
    },
    {
      "id": "slide-2",
      "title": "Тең бөлшектер және сан сәулесі",
      "text": "Жазылымдары бөлек бөлшектер бір нүктеде жатуы мүмкін.",
      "formula": "\\frac12=\\frac24",
      "diagram": {
        "kind": "number-line",
        "divisions": 4,
        "marks": [
          {
            "tick": 1,
            "label": "1/4"
          },
          {
            "tick": 2,
            "label": "1/2 = 2/4"
          },
          {
            "tick": 3,
            "label": "3/4"
          }
        ]
      },
      "steps": [
        "Алым мен бөлімді бірдей санға көбейт.",
        "1/2 = 2/4. Сан сәулесінде мәндері бірдей."
      ]
    },
    {
      "id": "slide-3",
      "title": "Ортақ бөлім",
      "text": "Қосылатын бөліктердің өлшемі бірдей болуы керек.",
      "formula": "\\frac27=\\frac4{14}",
      "diagram": null,
      "steps": [
        "7 мен 14 үшін ортақ бөлім — 14.",
        "2/7 = 4/14."
      ]
    },
    {
      "id": "slide-4",
      "title": "Қосудың шығарылған мысалы",
      "text": "Ортақ бөлімді сақтап, алымдарды қос.",
      "formula": "\\frac27+\\frac3{14}=\\frac12",
      "diagram": null,
      "steps": [
        "2/7 = 4/14.",
        "4/14 + 3/14 = 7/14.",
        "7/14 = 1/2."
      ]
    },
    {
      "id": "slide-5",
      "title": "Азайтудың шығарылған мысалы",
      "text": "Алдымен бірдей бөлімге келтір.",
      "formula": "\\frac79-\\frac13=\\frac49",
      "diagram": null,
      "steps": [
        "1/3 = 3/9.",
        "7/9 − 3/9 = 4/9."
      ]
    },
    {
      "id": "slide-6",
      "title": "Қысқарту",
      "text": "Алым мен бөлімді ортақ бөлгішке бөл.",
      "formula": "\\frac68=\\frac34",
      "diagram": null,
      "steps": [
        "6 мен 8-дің ортақ бөлгіші — 2.",
        "6/2 = 3; 8/2 = 4."
      ]
    },
    {
      "id": "slide-7",
      "title": "Көбейтудің шығарылған мысалы",
      "text": "Алымдарды және бөлімдерді өзара көбейт.",
      "formula": "\\frac47\\cdot\\frac7{12}=\\frac13",
      "diagram": null,
      "steps": [
        "4 × 7 = 28; 7 × 12 = 84.",
        "28/84 = 1/3."
      ]
    },
    {
      "id": "slide-8",
      "title": "Бөлу ережесі",
      "text": "Бөлуді екінші бөлшектің кері санына көбейтумен алмастыр.",
      "formula": "\\frac38:\\frac9{10}=\\frac38\\cdot\\frac{10}9",
      "diagram": null,
      "steps": [
        "Бірінші бөлшекті өзгертпе.",
        "Екінші бөлшектің алымы мен бөлімін ауыстыр."
      ]
    },
    {
      "id": "slide-9",
      "title": "Бөлудің жауабы",
      "text": "Көбейтуден кейін нәтижені қысқарт.",
      "formula": "\\frac38\\cdot\\frac{10}9=\\frac5{12}",
      "diagram": null,
      "steps": [
        "3/8 × 10/9 = 30/72.",
        "30/72 = 5/12."
      ]
    },
    {
      "id": "slide-10",
      "title": "Аралас сан",
      "text": "Алдымен аралас санды бұрыс бөлшекке айналдыр.",
      "formula": "1\\frac12=\\frac32",
      "diagram": null,
      "steps": [
        "Бір бүтінде 2 жарты бар.",
        "Тағы 1 жартыны қос: 2 + 1 = 3."
      ]
    },
    {
      "id": "slide-11",
      "title": "Амалдардың реті",
      "text": "Жақшадағы амалды бірінші орында.",
      "formula": "\\left(\\frac56-\\frac13\\right)\\cdot\\frac32=\\frac34",
      "diagram": null,
      "steps": [
        "1/3 = 2/6; 5/6 − 2/6 = 1/2.",
        "1/2 × 3/2 = 3/4."
      ]
    },
    {
      "id": "slide-12",
      "title": "Кері амалмен тексеру",
      "text": "Бөліндіні бөлгішке көбейткенде бастапқы бөлінгіш шығады.",
      "formula": "\\frac5{12}\\cdot\\frac9{10}=\\frac38",
      "diagram": null,
      "steps": [
        "5/12 × 9/10 = 45/120.",
        "45/120 = 3/8 — бастапқы бөлінгіш."
      ]
    }
  ]
}
