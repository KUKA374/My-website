{
  "schemaVersion": 1,
  "id": "fractions-review-v1",
  "title": "Бөлшектерді қайталау: жай және ондық бөлшектер",
  "slides": [
    {
      "id": "slide-1",
      "title": "Бөлшек нені білдіреді?",
      "text": "Бүтін тең бөліктерге бөлінеді. Алым алынған бөліктерді, бөлім барлық тең бөліктерді көрсетеді.",
      "formula": "",
      "diagram": {
        "kind": "fraction-bar",
        "parts": 4,
        "filled": 3
      }
    },
    {
      "id": "slide-2",
      "title": "Тең бөлшектер",
      "text": "Алым мен бөлімді бірдей нөлден өзге санға көбейту бөлшектің мәнін өзгертпейді.",
      "formula": "\\frac{1}{2}=\\frac{2}{4}",
      "diagram": null
    },
    {
      "id": "slide-3",
      "title": "Ортақ бөлім",
      "text": "Қосу алдында бөлшектерді бірдей бөлімге келтір.",
      "formula": "\\frac{1}{2}+\\frac{1}{4}=\\frac{2}{4}+\\frac{1}{4}",
      "diagram": null
    },
    {
      "id": "slide-4",
      "title": "Қосудың шешілген мысалы",
      "text": "Алымдар қосылады, ортақ бөлім сақталады.",
      "formula": "\\frac{2}{4}+\\frac{1}{4}=\\frac{3}{4}",
      "diagram": null
    },
    {
      "id": "slide-5",
      "title": "Азайтудың шешілген мысалы",
      "text": "Ортақ бөлім — 12.",
      "formula": "\\frac{3}{4}-\\frac{1}{6}=\\frac{9}{12}-\\frac{2}{12}=\\frac{7}{12}",
      "diagram": null
    },
    {
      "id": "slide-6",
      "title": "Көбейту",
      "text": "Алымдарды және бөлімдерді көбейтіп, нәтижені қысқарт.",
      "formula": "\\frac{2}{5}\\cdot\\frac{3}{4}=\\frac{3}{10}",
      "diagram": null
    },
    {
      "id": "slide-7",
      "title": "Бөлу",
      "text": "Екінші бөлшекке кері санға көбейт.",
      "formula": "\\frac{2}{3}:\\frac{4}{5}=\\frac{2}{3}\\cdot\\frac{5}{4}=\\frac{5}{6}",
      "diagram": null
    },
    {
      "id": "slide-8",
      "title": "Кері амалмен тексеру",
      "text": "Бөліндіні бөлгішке көбейткенде бөлінгіш шығады.",
      "formula": "\\frac{5}{6}\\cdot\\frac{4}{5}=\\frac{2}{3}",
      "diagram": null
    },
    {
      "id": "slide-9",
      "title": "Ондық бөлшек",
      "text": "Бөлімдері 10, 100, 1000 болатын бөлшектер ондық жазылыммен беріледі.",
      "formula": "\\frac{3}{10}=0{,}3",
      "diagram": null
    },
    {
      "id": "slide-10",
      "title": "Ондық бөлшектерді қосу",
      "text": "Үтірлер мен разрядтарды бірінің астына бірін келтір.",
      "formula": "0{,}50+0{,}25=0{,}75",
      "diagram": null
    },
    {
      "id": "slide-11",
      "title": "Көбейту мысалы",
      "text": "Натурал санға көбейтіп, үтір орнын тексер.",
      "formula": "1{,}2\\cdot3=3{,}6",
      "diagram": null
    },
    {
      "id": "slide-12",
      "title": "Бөлу және тексеру",
      "text": "Кері амал нәтижені тексеруге көмектеседі.",
      "formula": "4{,}8:2=2{,}4\\quad 2{,}4\\cdot2=4{,}8",
      "diagram": null
    }
  ]
}