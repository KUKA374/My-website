  "theory": [
    {
      "kind": "text",
      "text": "Жай бөлшек a/b бүтіннің тең бөліктерін білдіреді. b — бөлім, a — алым. Бөлім нөлге тең болмайды."
    },
    {
      "kind": "text",
      "text": "Бөлімдері әртүрлі бөлшектерді қосқанда немесе азайтқанда ортақ бөлімге келтіреміз. Бөлшектерді бөлгенде екінші бөлшекке кері санға көбейтеміз."
    },
    {
      "kind": "formula",
      "text": "a/b : c/d = a/b × d/c; b ≠ 0, c ≠ 0, d ≠ 0."
    }
  ],
  "examples": [
    {
      "id": "addition",
      "title": "Ортақ бөлімге келтіру",
      "steps": [
        "1/2 + 1/4",
        "1/2 = 2/4",
        "2/4 + 1/4 = 3/4"
      ],
      "answer": "3/4"
    },
    {
      "id": "division",
      "title": "Бөлшектерді бөлу",
      "steps": [
        "2/3 : 4/5",
        "2/3 × 5/4 = 10/12",
        "10/12 = 5/6"
      ],
      "answer": "5/6"
    }
  ],
